# Required: used to write the AI brief and as a fallback for finding competitors
OPENAI_API_KEY=

# Optional: free key from finnhub.io for the competitor list (falls back to AI-suggested peers without it)
FINNHUB_API_KEY=

# PostgreSQL for the portfolio (matches docker-compose.yml; start it with: docker compose up -d)
DATABASE_URL=postgresql+psycopg://alphasignal:alphasignal@localhost:5432/alphasignal

# Morning email (optional). Free key from resend.com; without your own domain Resend
# only delivers to the address you signed up with.
RESEND_API_KEY=
# DIGEST_FROM=AlphaSignal <onboarding@resend.dev>
# FRONTEND_URL=http://localhost:3000

# Queue between the backend and the agent workers (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
